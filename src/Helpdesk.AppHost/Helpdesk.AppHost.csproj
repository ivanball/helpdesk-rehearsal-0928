<Project Sdk="Aspire.AppHost.Sdk/13.0.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>249c7e98-30e3-4589-85bb-f2709c5abd1d</UserSecretsId>
    <!-- The Aspire AppHost SDK adds a platform-specific dashboard package
         (Aspire.Dashboard.Sdk.<the restoring machine's RID>) at restore time, so a lock file
         generated on a Windows or macOS laptop names win-x64/osx-x64 and fails CI's
         locked mode restore on ubuntu-latest with NU1004. The AppHost never ships (the
         release image is published from Helpdesk.Host), so it is opted out of the lock-file
         requirement Lab 5 turned on solution-wide rather than fighting a lock file that can
         never agree with every laptop OS and the Linux runner at once. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.0.0" />
    <!-- The AppHost pulls MessagePack 2.5.192 transitively (Kubernetes client), and that
         version carries published advisories. NuGetAudit is on, so the build refuses it.
         Naming the package directly pins the fixed version. Bump, never suppress. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives the AppHost a typed Projects.Helpdesk_Host handle. It is a build time
         reference only: the host does not reference the AppHost back. -->
    <ProjectReference Include="..\Helpdesk.Host\Helpdesk.Host.csproj" />
  </ItemGroup>

</Project>
